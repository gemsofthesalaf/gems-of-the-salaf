# Supabase Configuration
# The URL of your Supabase project (e.g., https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# The public anon key for Supabase (used on the client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key for Supabase (used on the server ONLY for admin tasks)
# NEVER expose this key to the client
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth: generate a long random value and store it only in the deployment secret store.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Site URL for SEO and canonical links (e.g., https://gemsofthesalaf.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Analytics Configuration
NEXT_PUBLIC_ENABLE_ANALYTICS=false
